      "transformations": [
        "Parse pinned Markdown with @slidev/parser 53.0.0; omit disabled records and retain each active slide’s trailing speaker-note comment, trimming only surrounding whitespace as the parser does.",
        "Read the published Slidev page for each active slide at clicks=999. Freeze the browser clock to the conference date at 12:00 UTC. Extract only that slide element’s innerText, excluding navigation UI.",
        "Store a same-slide screenshot at 1280x720 and reference it adjacent to its text. The export preserves DOM order; it does not encode spatial relationships or per-click ordering.",
        "Append public link targets from that source slide’s static href/Markdown links and Repo component names; include the timeline component’s public data-source link on its own slide.",
        "Combine visible slide text, linked screenshot, and that same slide’s original note text in an HTML comment. Sequential excerpt is an exact contiguous selection of these complete exported slide blocks."
      ],
      "verification": {
        "active_slide_count": 23,
        "pdf_page_count": 23,
        "disabled_source_slides": [
          21
        ],
        "checked_against_rendered_sources": [
          "ESLint PDF pages7–9 and browser slides4,8,11; Tools PDF page8 and browser slides3,8,10 inspected visually.",
          "Per-slide DOM/source/notes mapping saved; titles and active record counts match the PDFs.",
          "Speaker notes are original source comments, not inferred from the rendered slide."
        ],
        "protected_checks": [
          "Use raw source for style-edit checks: fenced code and inline code, HTML/Vue attributes, YAML front matter, commands, href/image targets, and click markers must survive.",
          "Compare numbers, versions, project names, conditions and attribution to the original before judging improved wording."
        ],
        "semantic_checks": [
          "Retain the distinction between configuration-format changes, helper tools, formatting, codemods, and non-JavaScript linting.",
          "Keep conditions, version numbers, and the distinction between experiments, stable support, and defaults.",
          "Author enthusiasm and first-person experience may remain; shorter output alone is not an improvement."
        ]
      },
      "limits": [
        "Live render assets are separately snapshot-hashed; their build cannot be proven to correspond exactly to the pinned Git revision. The archived PDF is a visual cross-check, not the tested rendered snapshot.",
        "DOM text includes off-viewport and reveal-controlled content. Do not score pixel visibility, intermediate reveals, clipped code, canvas semantics, or demo interaction as writing defects.",
        "Screenshots contain image/canvas/iframe content that innerText omits. A text-only reader that does not inspect those images has only a partial visual review; missing visual information is not an author-context gap.",
        "Date labels reflect the frozen conference-date clock. Archived PDF labels can differ due to export time.",
        "ESLint slide11 embeds the currently hosted Config Inspector app, and slide19 includes a video demo. Exclude their dynamic app/version/timing details. The seven-slide comparative excerpt avoids these demos."
      ]
    },
